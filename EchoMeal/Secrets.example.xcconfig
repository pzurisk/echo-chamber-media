// Copy this file to Secrets.xcconfig (same folder) and fill in real values.
// Secrets.xcconfig is gitignored. Never commit the real key.

// Anthropic API key from https://console.anthropic.com
// Leave empty when using the proxy below (App Store builds should).
ANTHROPIC_API_KEY = sk-ant-REPLACE-ME

// Cloudflare Worker relay URL (see Proxy/README.md). Empty means direct
// mode with the embedded key above. Gotcha: "//" starts a comment in
// xcconfig files, so write the URL with the $() trick like this:
// CLAUDE_PROXY_URL = https:/$()/mealtime-proxy.your-name.workers.dev
CLAUDE_PROXY_URL =

// Shared secret sent as the x-app-token header. Must match the APP_TOKEN
// secret on the Worker. Empty means the header is not sent.
CLAUDE_PROXY_TOKEN =

// Your Apple Developer Team ID (Xcode > Settings > Accounts, or
// developer.apple.com > Membership). Needed for device builds and TestFlight.
DEVELOPMENT_TEAM = REPLACE10
