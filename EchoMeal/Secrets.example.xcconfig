// Copy this file to Secrets.xcconfig (same folder) and fill in real values.
// Secrets.xcconfig is gitignored. Never commit the real key.

// There is deliberately no ANTHROPIC_API_KEY here. This file used to carry
// one, for a direct mode that called Anthropic straight from the phone, and
// that mode is gone: a key in an .ipa is a key anyone can unzip out of it.
// The key now lives only in the Cloudflare Worker's secret store. Do not add
// the line back.

// Cloudflare Worker relay URL (see Proxy/README.md). Required. Without it the
// app cannot plan at all and says so. Gotcha: "//" starts a comment in
// xcconfig files, so write the URL with the $() trick like this:
// CLAUDE_PROXY_URL = https:/$()/mealtime-proxy.your-name.workers.dev
CLAUDE_PROXY_URL =

// Shared secret sent as the x-app-token header. Must match the APP_TOKEN
// secret on the Worker. Empty means the header is not sent. This ships inside
// the app, so treat it as public: it proves a request came from a copy of
// MealTime and nothing more. The subscription check on the Worker is what
// actually decides who gets to spend.
CLAUDE_PROXY_TOKEN =

// Your Apple Developer Team ID (Xcode > Settings > Accounts, or
// developer.apple.com > Membership). Needed for device builds and TestFlight.
DEVELOPMENT_TEAM = REPLACE10
